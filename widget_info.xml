<?xml version="1.0" encoding="utf-8"?>
<!--
    Провайдер виджета GraphWidget.
    ВНИМАНИЕ: android:initialLayout обязан совпадать с R.layout.<имя>,
    которое вызывает сам GraphWidget.kt. Если там другое имя —
    AAPT упадёт на сборке с "resource layout/widget_calorie_chart not found".
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_calorie_chart"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
