<?xml version="1.0" encoding="utf-8"?>
<!-- GraphWidget: единственный элемент разметки. id "chart_image" обязан совпадать
     с R.id.chart_image в GraphWidget.updateWidget() — код вызывает только setImageViewBitmap. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chart_image"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC15151C"
    android:contentDescription="@string/widget_description"
    android:scaleType="fitCenter" />
